# ==========================================
# LIVEKIT CREDENTIALS
# ==========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIabc123
LIVEKIT_API_SECRET=secret123

# ==========================================
# OPENAI
# ==========================================
OPENAI_API_KEY=sk-...
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ==========================================
# ANTHROPIC / LLM
# ==========================================
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_LLM_MODEL=claude-haiku-4-5

# ==========================================
# DEEPGRAM STT (OPTIONAL)
# ==========================================
DEFAULT_STT_PROVIDER=openai
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# ==========================================
# SARVAM TTS
# ==========================================
DEFAULT_TTS_PROVIDER=sarvam
SARVAM_API_KEY=sarvam-...
SARVAM_TTS_SPEAKER=simran
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_PACE=0.95

# ==========================================
# WEBHOOK
# ==========================================
# If the backend runs on your host machine and the agent runs in Docker,
# host.docker.internal is usually the correct host.
BACKEND_WEBHOOK_URL=http://host.docker.internal:4000/api/call-screening/webhook/call-outcome

# ==========================================
# VOBIZ / SIP
# ==========================================
OUTBOUND_TRUNK_ID=ST_...
VOBIZ_SIP_DOMAIN=your-domain.sip.vobiz.ai
VOBIZ_USERNAME=your_username
VOBIZ_PASSWORD=your_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX
